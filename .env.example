# Configuración opcional de Gemini API
# Si no quieres poner tu clave aquí, también puedes ponerla directamente en la web en Ajustes -> Asistente Gemini.
# Este archivo no se sube a git (está en .gitignore).

GEMINI_API_KEY=tu_clave_de_gemini_aqui
# GEMINI_MODEL=gemini-3.8-flash  # Opcional (por defecto gemini-3.8-flash, con fallback automático)
